# Local defaults. Never put real tokens/passwords in this example.
PORTAL_ORIGIN=http://127.0.0.1:3000
# Preview remains local only; production login requires shared storage.
PORTAL_ENABLE_PREVIEW=true
PORTAL_ENABLE_VTEX_LOGIN=true

# Vercel Production: use the exact public origin below, disable preview,
# and connect an Upstash Redis database. Never commit real credentials.
# PORTAL_ORIGIN=https://customer-portal-volvo.vercel.app
# PORTAL_ENABLE_PREVIEW=false
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=set-in-vercel-only
